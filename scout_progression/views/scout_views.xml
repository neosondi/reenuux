<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Tree View -->
        <record id="view_scout_scout_tree" model="ir.ui.view">
            <field name="name">scout.scout.tree</field>
            <field name="model">scout.scout</field>
            <field name="arch" type="xml">
                <tree string="Scouts">
                    <field name="name"/>
                    <field name="date_of_birth"/>
                    <field name="unit_id"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_scout_scout_form" model="ir.ui.view">
            <field name="name">scout.scout.form</field>
            <field name="model">scout.scout</field>
            <field name="arch" type="xml">
                <form string="Scout">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="date_of_birth"/>
                            <field name="unit_id"/>
                        </group>
                        <notebook>
                            <page string="Progression">
                                <field name="progression_step_ids"/>
                            </page>
                            <page string="Badges">
                                <field name="badge_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
