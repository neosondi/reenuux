<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List View -->
        <record id="view_scout_unit_list" model="ir.ui.view">
            <field name="name">scout.unit.list</field>
            <field name="model">scout.unit</field>
            <field name="arch" type="xml">
                <list string="Units">
                    <field name="name"/>
                    <field name="leader_id"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_scout_unit_form" model="ir.ui.view">
            <field name="name">scout.unit.form</field>
            <field name="model">scout.unit</field>
            <field name="arch" type="xml">
                <form string="Unit">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="leader_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
