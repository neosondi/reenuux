<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Tree View -->
        <record id="view_scout_progression_tree" model="ir.ui.view">
            <field name="name">scout.progression.tree</field>
            <field name="model">scout.progression</field>
            <field name="arch" type="xml">
                <tree string="Progression Steps">
                    <field name="name"/>
                    <field name="badge_id"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_scout_progression_form" model="ir.ui.view">
            <field name="name">scout.progression.form</field>
            <field name="model">scout.progression</field>
            <field name="arch" type="xml">
                <form string="Progression Step">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="badge_id"/>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
